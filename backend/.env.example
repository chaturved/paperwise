# App
APP_URL=http://localhost:3000

# Database (keep the +psycopg: requirements.txt installs psycopg 3, and a plain postgresql:// URL asks for psycopg2)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/paperwise

# JWT — generate with: openssl rand -hex 32
JWT_SECRET_KEY=
SESSION_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP (magic link + password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Paperwise
SMTP_FROM_EMAIL=noreply@paperwise.ai

# AI provider: "gemini" or "huggingface" (embedding vectors must stay 384-dim)
AI_PROVIDER=gemini
EMBEDDING_DIMENSIONS=384

# Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Hugging Face
HF_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

# S3 / Supabase Storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_LIBRARY_BUCKET=library

# CORS (comma-separated list handled by pydantic-settings)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Text Processing
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=50
